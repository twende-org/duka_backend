# Copy to .env and adjust per environment. Never commit the real file.
# Both compose files read it: docker-compose interpolates ${VAR} from it, and
# each service also receives it via env_file. A bare `manage.py runserver` needs
# the variables exported into your shell instead:
#   set -a && . ./.env && set +a

# --- Production values (docker compose -f docker-compose.prod.yml) ------------
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">
# DJANGO_ALLOWED_HOSTS=backend.twendedigital.tech
# POSTGRES_DB=duka_backend_db
# POSTGRES_USER=duka_backend
# POSTGRES_PASSWORD=<same POSTGRES_PASSWORD the compose file passes to the db service>
# POSTGRES_HOST=db
# CELERY_BROKER_URL=redis://redis:6379/0
# REDIS_CACHE_URL=redis://redis:6379/1
# CORS_ALLOWED_ORIGINS=https://duka.twendedigital.tech
# CSRF_TRUSTED_ORIGINS=https://duka.twendedigital.tech,https://backend.twendedigital.tech
# REEL_PUBLIC_BASE_URL=https://backend.twendedigital.tech
# GOOGLE_CLIENT_ID=<same VITE_GOOGLE_CLIENT_ID as the frontend .env>
# OPENROUTER_API_KEY=<server-side key for intake AI / captions / insights>

# --- Compose-only variables (interpolated, not read by Django) ------------------
# Host port the local stack publishes the API on (docker-compose.yml). Kept off
# 8000 because that port is commonly taken on shared dev machines.
# BACKEND_PORT=8009
# Image the server pulls instead of building (docker-compose.prod.yml).
# BACKEND_IMAGE=duka_backend:latest
# Public hostname Traefik routes to the api service (docker-compose.prod.yml).
# BACKEND_HOST=backend.twendedigital.tech

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API (comma separated). Must include the frontend
# origin, e.g. https://duka.twendedigital.tech in production. In DEBUG any
# localhost/127.0.0.1 port is allowed on top of this list.
CORS_ALLOWED_ORIGINS=

# --- Database ---
# Leave POSTGRES_DB unset to fall back to the local sqlite file (dev only).
# The values below match the `db` service in docker-compose.yml.
POSTGRES_DB=
POSTGRES_USER=duka_backend
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Seconds a pooled connection is kept before Django drops it. Each gunicorn
# worker holds up to this many, so size Postgres max_connections to match.
DB_CONN_MAX_AGE=600

# --- Auth / Firebase bridge ---
GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=duka-smart-16c8e
# Path to the service-account JSON, or raw JSON content. Only needed by
# `manage.py import_firestore`; the key file is not kept in the repository.
FIREBASE_CREDENTIALS=

# --- Celery (ported Cloud Functions) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Unset to discard results; e.g. redis://127.0.0.1:6379/1 to store them.
CELERY_RESULT_BACKEND=
# true runs tasks inline (useful for single-process dev).
CELERY_TASK_ALWAYS_EAGER=false

# --- Facebook Login (social domain) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match the URI registered on the Facebook app; defaults to the legacy
# Cloud Functions callback.
FACEBOOK_REDIRECT_URI=
# Extra origins the OAuth callback may redirect back to (comma separated).
# The production origin is always allowed; localhost works in dev.
FACEBOOK_ALLOWED_ORIGINS=
# Webhook (Facebook -> Django): GET handshake token. Defaults to the legacy
# Cloud Function's token when unset.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# true (default): POST events must be signed with FACEBOOK_APP_SECRET. Only
# relevant once an app secret is configured (without one, checks are skipped).
FACEBOOK_WEBHOOK_VERIFY_SIGNATURE=true
# Passphrase for stored tokens (crypto-js envelope). The Cloud Functions used
# ENCRYPTION_KEY; leave both unset to use the legacy default passphrase.
SOCIAL_TOKEN_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# --- Social posting / auto-reply ---
# OpenRouter key. Also powers the dashboard assistant and the product-intake
# AI below; QR intake and the caption fallback keep working without it.
OPENROUTER_API_KEY=
# Public base URL of this deployment (e.g. https://api.example.com). Reels are
# generated only when set, because Facebook fetches the video over the internet.
REEL_PUBLIC_BASE_URL=

# --- Product intake AI (invoice photo -> staged drafts) ---
# Plugging in OPENROUTER_API_KEY above is all that is required. The cheap
# model reads the invoice first; the strong model is only called when that
# first pass comes back empty, unparsable, or low-confidence.
# AI_INTAKE_MODEL=google/gemini-2.5-flash
# AI_INTAKE_MODEL_STRONG=google/gemini-2.5-pro
# AI_INTAKE_MIN_CONFIDENCE=0.6

# --- Delivery App sync (second Firebase project: fast-tz) ---
# Mirrors published products into the courier marketplace project, replacing the
# deliverySync.js Cloud Functions. Default off: while unset/false nothing is ever
# written to the remote project (the tasks return "disabled").
DELIVERY_APP_SYNC_ENABLED=false
# Service-account JSON for the Delivery App project. The key is no longer kept in
# the repository; set this to the file's location to enable the sync.
DELIVERY_APP_CREDENTIALS=
DELIVERY_APP_PROJECT_ID=fast-tz
DELIVERY_APP_COLLECTION=products
# Firestore batch write limit is 500; the legacy script used 400.
DELIVERY_APP_BATCH_SIZE=400
